# Nomic API Key (for embeddings - FREE, high quality)
NOMIC_API_KEY=your_nomic_api_key_here

# Optional: Use sentence-transformers (local, no API needed)
# Set USE_LOCAL_EMBEDDINGS=true to use local embeddings instead of Nomic
USE_LOCAL_EMBEDDINGS=false

# LanceDB path
LANCEDB_PATH=./data/lancedb

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
